{
	"name": "ns-featured-posts",
	"version": "4.0.0",
	"description": "NS Featured Posts",
	"keywords": [
		"wordpress",
		"wordpress-plugin"
	],
	"homepage": "https://github.com/ernilambar/ns-featured-posts",
	"bugs": {
		"url": "https://github.com/ernilambar/ns-featured-posts/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/ernilambar/ns-featured-posts"
	},
	"license": "GPL-2.0-or-later",
	"author": "Nilambar Sharma",
	"main": "ns-featured-posts.php",
	"scripts": {
		"predeploy": "rimraf deploy vendor && pnpm run vendor",
		"deploy": "packtor",
		"format": "prettier \"**/*.{cjs,css,js,json,mjs}\" --write --log-level warn",
		"pot": "composer run-script pot",
		"vendor": "composer install --no-dev --no-scripts -o",
		"version": "easy-replace-in-files",
		"wpassets": "wp-deployer --assets",
		"prewpdeploy": "pnpm run deploy",
		"wpdeploy": "wp-deployer"
	},
	"browserslist": "> 1%, not dead",
	"devDependencies": {
		"@wordpress/prettier-config": "^4.54.0",
		"easy-replace-in-files": "^2.0.0",
		"packtor": "^2.0.0",
		"prettier": "npm:wp-prettier@^3.0.3",
		"rimraf": "^6.1.3",
		"wp-deployer": "^2.1.0"
	},
	"packageManager": "pnpm@11.25.0",
	"engines": {
		"pnpm": ">=11"
	},
	"wpDeployer": {
		"repoType": "plugin",
		"username": "nilambar",
		"buildDir": "deploy/ns-featured-posts",
		"deployAssets": false
	}
}
